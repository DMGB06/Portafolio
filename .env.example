# Copia este archivo como .env.local y completa los valores.
# Next.js carga automáticamente .env.local en desarrollo.

# API Key de Resend (https://resend.com/api-keys)
# Necesaria para que funcione el formulario de contacto (/api/contact)
RESEND_API_KEY=re_tu_api_key_aqui

# Email de contacto públicamente visible (se muestra en la UI)
NEXT_PUBLIC_CONTACT_EMAIL=tu-email@example.com

# Email destino para recibir mensajes del formulario (solo servidor)
OWNER_EMAIL_FOR_MESSAGES=tu-email@example.com
